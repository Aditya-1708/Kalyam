generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?
  role     Role    @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medicine {
  id          Int        @id @default(autoincrement())
  brand       String
  sku         String     @unique
  strength    String
  threapyArea String? 
  target      TargetType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TargetType {
  HUMAN
  ANIMAL
}

enum Role {
  ADMIN
  USER
}

enum ProductCategory {
  HUMAN
  VETERINARY
}

model Product {
  id        Int      @id @default(autoincrement())

  name      String
  slug      String   @unique
  image     String

  category  ProductCategory @default(HUMAN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}